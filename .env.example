APP_NAME=Smart Production Monitoring API
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Try ports in order; fallback handles common 3306/3307 setups.
DB_HOST=127.0.0.1
DB_PORTS=3306,3307
DB_NAME=smart_production_db
DB_USER=root
DB_PASSWORD=change_me
DB_CONNECT_TIMEOUT=5
AUTO_CREATE_DATABASE=true
AUTO_CREATE_TABLES=true

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=60
